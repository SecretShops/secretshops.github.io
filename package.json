{
  "name": "secretshop-static",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:catalog": "python scripts/build-product-families.py && node scripts/build-marketplace-catalog.mjs && node scripts/build-affiliate-links.mjs && node scripts/promote-eligible-regions.mjs && node scripts/build-regional-site.mjs",
    "build:regions": "node scripts/build-affiliate-links.mjs && node scripts/promote-eligible-regions.mjs && node scripts/build-regional-site.mjs",
    "test": "node --test tests/*.test.mjs scripts/import-awin.test.mjs scripts/import-impact-shokz.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs && node scripts/audit-affiliate-links.mjs",
    "validate:regions": "node scripts/validate-regions.mjs",
    "regions:promote": "node scripts/promote-eligible-regions.mjs",
    "validate:site": "node scripts/check-site.mjs",
    "quality": "npm run build:catalog && npm test && npm run validate:catalog && npm run validate:regions && npm run validate:seo && npm run validate:site",
    "quality:full": "npm run quality && npm run test:browser",
    "amazon:links": "node scripts/build-amazon-links.mjs",
    "amazon:import:dry": "node scripts/import-amazon-products.mjs --dry-run",
    "amazon:import": "node scripts/import-amazon-products.mjs && npm run quality",
    "impact:shokz:dry": "node scripts/import-impact-shokz.mjs --dry-run",
    "impact:shokz:import": "node scripts/import-impact-shokz.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "awin:import": "node scripts/import-awin.mjs",
    "awin:refresh": "node scripts/refresh-awin-catalogs.mjs",
    "awin:promotions": "node scripts/refresh-awin-promotions.mjs",
    "awin:bikila:dry": "node scripts/import-awin.mjs data/sources/awin/bikila-es.csv.gz --merchant bikila-es --dry-run",
    "awin:bikila:import": "node scripts/import-awin.mjs data/sources/awin/bikila-es.csv.gz --merchant bikila-es",
    "catalog:prepared:check": "node scripts/import-prepared-catalog.mjs",
    "lounge:es:check": "node scripts/import-prepared-catalog.mjs data/sources/lounge-eu/lounge-es-catalogo-preparado.csv lounge-eu",
    "lounge:pt:check": "node scripts/import-prepared-catalog.mjs data/sources/lounge-eu/lounge-pt-catalogo-preparado.csv lounge-eu"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "python": ">=3.10"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "axe-core": "^4.12.1",
    "playwright": "^1.61.1",
    "vite": "^8.1.5"
  }
}
